# LIMS analyzer relay — config for ONE analyzer that waits to be connected to
# (e.g. Mindray BC-5150). Copy to relay.env and edit the two marked lines.

# The analyzer's own IP on the lab network (its Setup -> Communication screen).
ANALYZER_HOST=192.168.1.150
# Port the analyzer listens on. Mindray BC-5150: 5100.
ANALYZER_PORT=5100

# The central gateway (same for every lab).
GATEWAY_HOST=209.38.124.112
# THIS LAB'S PORT, shown in the LIMS under Instrument Mappings after
# "Connect analyzer". 5150 is the shared test port.
GATEWAY_PORT=5150
