# Droplet config for the central instrument gateway. Copy to
# /etc/lims-instrument-gateway.env (chmod 600, owned by root).

# --- Central mode ------------------------------------------------------------
# One gateway serves every lab. Each lab's analyzer gets its own port from the
# LIMS ("Connect analyzer" on Instrument Mappings); the gateway polls the LIMS
# for the port list every CONNECTIONS_POLL_MS and opens/closes ports to match.
CENTRAL_MODE=1
CONNECTIONS_POLL_MS=60000

# The shared port, kept open for an analyzer that hasn't been given its own
# port yet. The first lab to click "Connect analyzer" is assigned 5150 itself.
# Open the whole range in ufw:  ufw allow 5150:5199/tcp
INSTRUMENT_TCP_PORT=5150

# Health check only. NOT opened in ufw:  curl -s localhost:4002/health
INSTRUMENT_HTTP_PORT=4002

# The LIMS. The connections list is fetched from the same base URL
# (/api/instruments/connections) unless CONNECTIONS_URL is set.
APP_INGEST_URL=https://qibitlabs.com/api/instruments/results

# Bearer secret shared with the app. Must match INSTRUMENT_GATEWAY_SECRET in
# Vercel. Generate with: openssl rand -hex 32
INSTRUMENT_GATEWAY_SECRET=

FORWARD_ATTEMPTS=3
FORWARD_TIMEOUT_MS=10000

# Keep-alive probes on idle analyzer connections (ms), so ISP NAT timeouts
# don't silently drop them between samples.
TCP_KEEPALIVE_MS=60000

# Parse settings for the shared port only. Ports assigned in the LIMS use their
# analyzer model's settings from the app's catalog instead.
INSTRUMENT_ID=erba-h360
HL7_BARCODE_LOCATION=OBR-3
HL7_CODE_COMPONENT=2

# Record every byte analyzers send to spool/raw-capture.log. Useful when
# connecting a new analyzer model; leave off otherwise.
CAPTURE_RAW=0

INSTRUMENT_GATEWAY_LOG_LEVEL=info
