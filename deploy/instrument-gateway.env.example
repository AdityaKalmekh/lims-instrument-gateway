# Droplet config for the instrument gateway. Copy to
# /etc/lims-instrument-gateway.env (chmod 600, owned by root).

# Port the analyzers connect to over the internet. Must be opened in ufw.
INSTRUMENT_TCP_PORT=5150

# Health check only. NOT opened in ufw, so it stays private to the droplet:
#   curl -s localhost:4002/health
INSTRUMENT_HTTP_PORT=4002

# --- Connectivity test: forwarding OFF ------------------------------------
# During the test we only prove the analyzer can reach the droplet. Pointing
# the ingest URL at a closed local port makes every message land in ./spool
# (and nothing reaches the LIMS), which is exactly the evidence we want.
# The analyzer is still ACKed — the gateway ACKs before it forwards.
APP_INGEST_URL=http://127.0.0.1:9/forwarding-disabled-during-test
INSTRUMENT_GATEWAY_SECRET=unused-during-test
FORWARD_ATTEMPTS=1

# Record every byte the analyzer sends to spool/raw-capture.log.
CAPTURE_RAW=1

INSTRUMENT_ID=erba-h360
HL7_BARCODE_LOCATION=OBR-3
# The H-360 puts the readable analyte code (WBC, HGB, ...) in OBX-3 component 2.
HL7_CODE_COMPONENT=2

INSTRUMENT_GATEWAY_LOG_LEVEL=info
