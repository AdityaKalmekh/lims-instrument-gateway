# Instrument gateway configuration. Copy to .env (loaded by your process
# manager) or set these in the environment before `npm start`.

# TCP port the analyzer transmits HL7/MLLP to. Set the SAME port in the
# H-360's LIS/host-communication menu, pointed at this PC's LAN IP.
INSTRUMENT_TCP_PORT=5150

# Health-check HTTP port (monitoring only; the analyzer does not use it).
INSTRUMENT_HTTP_PORT=4002

# The LIMS app endpoint that ingests results (built in the next phase).
APP_INGEST_URL=https://qibitlabs.com/api/instruments/results

# Bearer secret shared with the app. Must match INSTRUMENT_GATEWAY_SECRET in
# the Next.js app's environment. CHANGE THIS IN PRODUCTION.
INSTRUMENT_GATEWAY_SECRET=dev-secret

# Label identifying which physical analyzer this gateway serves.
INSTRUMENT_ID=erba-h360

# Where the sample barcode lives in the HL7 message. Default OBR-3 (filler
# order number). Confirm against the real H-360 dump; common alternatives are
# OBR-2 or PID-3.
HL7_BARCODE_LOCATION=OBR-3

# Forward retry behaviour before a message is spooled to ./spool.
FORWARD_ATTEMPTS=3
FORWARD_TIMEOUT_MS=10000

# pino log level (trace|debug|info|warn|error)
INSTRUMENT_GATEWAY_LOG_LEVEL=info
